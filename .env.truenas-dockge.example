# EXAMPLE ONLY. Never put your real copy in GitHub.
# Enter the real values in Dockge's local .env editor on TrueNAS.

GITHUB_USERNAME=your-github-username
MEDIALOGUE_IMAGE_TAG=latest
MEDIALOGUE_PORT=8000

PUID=568
PGID=568
TZ=UTC

# Optional. Leave unset to persist a generated key in /config/application-secret.
# Generate a real override locally if desired; do not commit it.
# MEDIALOGUE_SECRET_KEY=

# TrueNAS host paths. These are examples only.
CONFIG_HOST_PATH=/mnt/YOUR_POOL/appdata/medialogue/config
TORRENT_ARCHIVE_HOST_PATH=/mnt/YOUR_POOL/appdata/medialogue/torrent-archive
MOVIES_HOST_PATH=/mnt/YOUR_POOL/media/movies
SHOWS_HOST_PATH=/mnt/YOUR_POOL/media/shows

# Optional Google Drive backups. Configure a Google OAuth Web application with
# the Drive API enabled. The URI must exactly match the authorized redirect URI.
MEDIALOGUE_GOOGLE_DRIVE_CLIENT_ID=
MEDIALOGUE_GOOGLE_DRIVE_CLIENT_SECRET=
MEDIALOGUE_GOOGLE_DRIVE_REDIRECT_URI=
