# Medialogue release/deployment
MEDIALOGUE_VERSION=0.1.0
MEDIALOGUE_IMAGE=medialogue:local
MEDIA_MANAGER_PORT=8000
TZ=UTC

# Container user used after startup directory preparation.
PUID=10001
PGID=10001

# Persistent application-owned directories
CONFIG_DIR=./.local/config
TORRENT_ARCHIVE_DIR=./.local/torrent-archive

# Example media bind. Add additional explicit binds in docker-compose.yml as needed.
MEDIA_DIR=./media

# Optional application-secret override used for sessions and signed destructive
# confirmations. Leave unset to persist a generated key in /config/application-secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MEDIALOGUE_SECRET_KEY=
LOG_LEVEL=INFO
COOKIE_SECURE=false

# Temporary Recovery Bundle download lifetime.
RECOVERY_EXPORT_RETENTION_HOURS=1

# Optional Google Drive backups. Configure a Google OAuth Web application with
# the Drive API enabled. The URI must exactly match the authorized redirect URI.
MEDIALOGUE_GOOGLE_DRIVE_CLIENT_ID=
MEDIALOGUE_GOOGLE_DRIVE_CLIENT_SECRET=
MEDIALOGUE_GOOGLE_DRIVE_REDIRECT_URI=
