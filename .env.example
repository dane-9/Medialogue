# Medialogue release/deployment
MEDIALOGUE_VERSION=0.1.0
MEDIALOGUE_IMAGE=medialogue:local
MEDIA_MANAGER_PORT=8000
TZ=UTC

# Container user used after startup directory preparation.
PUID=10001
PGID=10001

# Persistent application-owned directories
CONFIG_DIR=./.local/config
TORRENT_ARCHIVE_DIR=./.local/torrent-archive

# Example media bind. Add additional explicit binds in docker-compose.yml as needed.
MEDIA_DIR=./media

# PostgreSQL
POSTGRES_DB=media_manager
POSTGRES_USER=media_manager
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Application secret used for sessions and signed destructive confirmations.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
LOG_LEVEL=INFO
COOKIE_SECURE=false

# Temporary Recovery Bundle download lifetime.
RECOVERY_EXPORT_RETENTION_HOURS=24
